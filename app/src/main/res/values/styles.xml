<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PokeVault" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/nunito_sans_regular</item>
        <item name="android:colorAccent">@color/vault_red</item>
        <item name="android:windowBackground">@color/vault_background</item>
        <item name="android:statusBarColor">@color/vault_background</item>
        <item name="android:navigationBarColor">@color/vault_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.PokeVault" parent="@style/PokeVault" />
    <style name="PokeVault.PageTitle">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/vault_dark</item>
        <item name="android:textSize">28sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="PokeVault.SectionTitle">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/vault_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="PokeVault.Body">
        <item name="android:fontFamily">@font/nunito_sans_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="PokeVault.PrimaryButton">
        <item name="android:background">@drawable/button_red</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PokeVault.SecondaryButton">
        <item name="android:background">@drawable/button_outline_navy</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/vault_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:elevation">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
