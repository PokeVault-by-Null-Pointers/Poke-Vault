<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0D879"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFF0A6" android:endColor="#F9C74F"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="@color/vault_gold_dark"/>
        </shape>
    </item>
</selector>